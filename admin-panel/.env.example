# Frontend API URL (production)
REACT_APP_API_URL=https://utpl-safety-backend.onrender.com/api/v1
REACT_APP_LEGACY_API_URL=https://utpl-safety-backend.onrender.com

# Optional login branding; these values match the current portal defaults.
REACT_APP_APP_NAME=Safety Management System
REACT_APP_ORGANIZATION_NAME=Udupi Tollway Pvt. Ltd.
REACT_APP_APP_VERSION=0.1.0
# Enables the email-support action on the password-assistance screen when set.
REACT_APP_SUPPORT_EMAIL=

# GPS evidence policy is enforced by the backend; these values drive matching UI warnings.
REACT_APP_GPS_EVIDENCE_POLICY=optional
REACT_APP_MAX_ACCEPTABLE_GPS_ACCURACY_METERS=100
REACT_APP_GOOGLE_MAPS_API_KEY=
REACT_APP_GOOGLE_MAP_ID=
REACT_APP_DEFAULT_MAP_LAT=13.494759
REACT_APP_DEFAULT_MAP_LNG=74.719246
REACT_APP_DEFAULT_MAP_ZOOM=18
