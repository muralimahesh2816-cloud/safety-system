# Backend reads env from project root .env.
# This file is a reference mirror for backend team members.
# Copy values into: ../.env

NODE_ENV=production
APP_NAME=Safety Management System
PORT=5000
BACKEND_PUBLIC_URL=https://your-api.onrender.com
FRONTEND_URL=https://your-app.vercel.app,https://your-custom-domain.com
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.xxxxx.mongodb.net/safety_hse?retryWrites=true&w=majority&appName=Cluster0
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=300
SESSION_TIMEOUT_MINUTES=30
CLOUDINARY_CLOUD_NAME=dfieglndb
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_FOLDER=uploads
GPS_EVIDENCE_POLICY=optional
MAX_ACCEPTABLE_GPS_ACCURACY_METERS=100
MEDIA_LOCATION_RETENTION_DAYS=0
MAP_PROVIDER=none
MAP_API_KEY=
REVERSE_GEOCODING_PROVIDER=none
REVERSE_GEOCODING_API_URL=
REVERSE_GEOCODING_API_KEY=
REVERSE_GEOCODING_TIMEOUT_MS=10000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=otp@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="Safety Management System <otp@example.com>"

# --- Mobile OTP sign-in -----------------------------------------------------
# Where the login code is delivered. "auto" prefers WhatsApp when the user has
# a mobile number on file and WhatsApp is enabled, and falls back to email.
# "email" and "whatsapp" force one channel.
OTP_CHANNEL=auto
# Default country used to read a locally-typed number into E.164 (IN/AE/GB/US).
DEFAULT_PHONE_COUNTRY=IN

# --- Auth rate limiting -----------------------------------------------------
# Per-IP budget across all auth routes. Sized for a shared office/site NAT,
# where many workers legitimately sign in from one address at shift change.
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=40
# Per-mobile-number budget for requesting a code. This is the limit that
# actually protects a user, because it is scoped to their identity rather than
# to whatever address they happen to share.
OTP_RATE_LIMIT_WINDOW_MS=900000
OTP_RATE_LIMIT_MAX=5

# --- WhatsApp notifications -------------------------------------------------
# Master switch. Left false, the outbound queue still runs and still records
# every delivery attempt, resolving it through the "log" provider instead of
# calling out. Assignment -> notification -> delivery is therefore exercised in
# development without a live Meta account; going live is config, not code.
WHATSAPP_ENABLED=false
# "log" (no network) or "meta" (WhatsApp Business Cloud API).
WHATSAPP_PROVIDER=log
# Required when WHATSAPP_ENABLED=true and WHATSAPP_PROVIDER=meta.
# Never commit real values - set them in the host's secret manager.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
# Meta requires a pre-approved template for business-initiated messages (those
# outside the 24-hour customer service window). Leave blank to send plain text,
# which only works inside that window.
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_ASSIGNMENT_TEMPLATE=
