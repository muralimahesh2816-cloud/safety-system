# ==========================================
# Safety HSE Backend - Production Template
# Copy to: .env (project root) or set in Render
# ==========================================

NODE_ENV=production
APP_NAME=Safety Management System
PORT=5000

# Public URLs
BACKEND_PUBLIC_URL=https://utpl-safety-backend.onrender.com
FRONTEND_URL=https://safety-system-m1my.onrender.com

# MongoDB Atlas URI
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.xxxxx.mongodb.net/safety_hse?retryWrites=true&w=majority&appName=Cluster0

# JWT secrets
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password hashing + API protection
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=300
SESSION_TIMEOUT_MINUTES=30

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=dfieglndb
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_FOLDER=uploads

# GPS-stamped evidence (optional|required|required_camera)
GPS_EVIDENCE_POLICY=optional
MAX_ACCEPTABLE_GPS_ACCURACY_METERS=100
MEDIA_LOCATION_RETENTION_DAYS=0
MAP_PROVIDER=none
MAP_API_KEY=
REVERSE_GEOCODING_PROVIDER=none
REVERSE_GEOCODING_API_URL=
REVERSE_GEOCODING_API_KEY=
REVERSE_GEOCODING_TIMEOUT_MS=10000

# Email OTP delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=otp@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="Safety Management System <otp@example.com>"
GOOGLE_GEOCODING_API_KEY=
GOOGLE_GEOCODING_TIMEOUT_MS=10000

# --- WhatsApp assignment notifications -------------------------------------
# Off by default. With WHATSAPP_ENABLED=false the notification queue still runs
# and still records every delivery attempt — it resolves them through the `log`
# provider instead of calling Meta, so the full assignment -> notification path
# works without credentials. Set to true only once the values below are real.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=meta
WHATSAPP_API_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=replace-with-meta-system-user-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=replace-with-waba-id
# Meta requires a pre-approved template for business-initiated messages.
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_ASSIGNMENT_TEMPLATE=

# Where the login OTP is delivered: auto | whatsapp | email
# `auto` sends to WhatsApp for a mobile-number sign-in and email otherwise.
OTP_CHANNEL=auto

# Login rate limiting. Per-IP budget plus a stricter per-mobile-number budget
# (the latter is what protects an individual account from OTP bombing).
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=40
OTP_RATE_LIMIT_WINDOW_MS=900000
OTP_RATE_LIMIT_MAX=5
