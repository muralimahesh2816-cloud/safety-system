# ==========================================
# Safety HSE Backend - Production Template
# Copy to: .env (project root)
# ==========================================

NODE_ENV=production
PORT=5000

# Public API base used in generated upload URLs
BACKEND_PUBLIC_URL=https://your-api.onrender.com

# Comma-separated list of allowed frontend origins
FRONTEND_URL=https://your-app.vercel.app,https://your-custom-domain.com

# MongoDB Atlas URI (URL-encode special characters in password)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.xxxxx.mongodb.net/safety_hse?retryWrites=true&w=majority&appName=Cluster0

# JWT secrets (set strong random values)
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password hashing + API protection
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=300
SESSION_TIMEOUT_MINUTES=30

# Cloudinary (recommended for production media persistence)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
