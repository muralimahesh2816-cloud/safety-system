# ==========================================
# Safety HSE Backend - Production Template
# Copy to: .env (project root) or set in Render
# ==========================================

NODE_ENV=production
APP_NAME=Safety Management System
PORT=5000

# Public URLs
BACKEND_PUBLIC_URL=https://utpl-safety-backend.onrender.com
FRONTEND_URL=https://safety-system-m1my.onrender.com

# MongoDB Atlas URI
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.xxxxx.mongodb.net/safety_hse?retryWrites=true&w=majority&appName=Cluster0

# JWT secrets
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password hashing + API protection
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=300
SESSION_TIMEOUT_MINUTES=30

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=dfieglndb
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_FOLDER=uploads

# GPS-stamped evidence (optional|required|required_camera)
GPS_EVIDENCE_POLICY=optional
MAX_ACCEPTABLE_GPS_ACCURACY_METERS=100
MEDIA_LOCATION_RETENTION_DAYS=0
MAP_PROVIDER=none
MAP_API_KEY=
REVERSE_GEOCODING_PROVIDER=none
REVERSE_GEOCODING_API_URL=
REVERSE_GEOCODING_API_KEY=
REVERSE_GEOCODING_TIMEOUT_MS=10000

# Email OTP delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=otp@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="Safety Management System <otp@example.com>"
GOOGLE_GEOCODING_API_KEY=
GOOGLE_GEOCODING_TIMEOUT_MS=10000
